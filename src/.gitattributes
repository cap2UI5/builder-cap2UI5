# Normalize line endings to LF for all text files.
#
# Ships into the published cap2UI5 app, which vendors the generated core/
# tree - CONVENTIONS §6 asks every repository carrying a generated tree for
# this file, and the app repo's content outside .github/ can only come from
# here.
* text=auto eol=lf
*.abap text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
