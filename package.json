{
  "name": "builder-cap2ui5",
  "version": "1.0.0",
  "private": true,
  "description": "Builder project for the full CAP app — mirrors the published core package (abap2UI5) from builder-abap2UI5-js, assembles src/ + the vendored core + its webapp and publishes the result 1:1 into the cap2UI5 app repository",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "mirror_core": "node scripts/mirror-core.js",
    "assemble": "node scripts/assemble-cap.js",
    "publish": "node scripts/publish-cap.js",
    "build_cap": "node scripts/assemble-cap.js && node scripts/publish-cap.js",
    "test": "npm run test:builder && npm run test:app",
    "test:builder": "jest",
    "test:app": "npm --prefix run/output/cap2UI5 test"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  },
  "repository": "github:cap2UI5/builder-cap2UI5",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "jest": "^30.5.1"
  }
}
